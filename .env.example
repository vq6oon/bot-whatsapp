# Bot WhatsApp number used for pairing-code login.
# Leave empty to scan the QR code in the terminal.
WA_PAIR_NUMBER=

# Optional Google Drive folder ID for Drive helpers.
DRIVE_FOLDER_ID=

# Python interpreter used to run the bundled yt-dlp binary (default: python3.11).
YOUTUBE_DL_PYTHON=

# Absolute path to a yt-dlp binary; wins over the bundled one.
YTDLP_BIN=

# Netscape cookies export for YouTube. When empty, ./cookies.txt is used if present.
# Only a logged-in export is used (LOGIN_INFO, or SID + SAPISID).
YOUTUBE_COOKIES=

# Optional proxy for YouTube requests, e.g. http://user:pass@host:port
YOUTUBE_PROXY=

# ani-cli binary, menu shim, and download timeout in ms.
ANI_CLI_BIN=ani-cli
ANI_CLI_MENU=/usr/local/bin/ani-pick-first
ANI_DL_TIMEOUT_MS=900000